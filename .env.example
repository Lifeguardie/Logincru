# ===== AliExpress Affiliate API (https://portals.aliexpress.com) =====
ALI_APP_KEY=your_app_key
ALI_APP_SECRET=your_app_secret
ALI_TRACKING_ID=your_tracking_id

# ===== Telegram =====
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-your-token
# Channel: @your_channel or -100xxxxxxxxxx (bot must be channel admin)
TELEGRAM_CHANNEL_ID=@your_channel
# Optional: your private chat id for error alerts (talk to @userinfobot to get it)
ADMIN_CHAT_ID=

# ===== Behavior (all optional, defaults shown) =====
# AliExpress first-level category IDs, comma separated.
# 15 = Home & Garden, 44 = Consumer Electronics. Full list via aliexpress.affiliate.category.get
ALI_CATEGORY_IDS=15,44
MIN_DISCOUNT_PERCENT=30
PRICE_MIN_USD=5
PRICE_MAX_USD=100
# Skip products already posted within this many days
DEDUPE_DAYS=30
# Posts per scheduler run
POSTS_PER_RUN=3
# Cron schedule (default: every 6 hours for the first week; later switch to every 3: 0 */3 * * *)
CRON_EXPRESSION=0 */6 * * *
# Ship-to country for prices/availability
SHIP_TO_COUNTRY=IL
# 1 = build posts but do not send to Telegram and do not write to DB
DRY_RUN=0
