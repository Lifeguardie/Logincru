# ---- שרת ----
PORT=4010
NODE_ENV=production
# סוד לחתימת טוקנים. חובה להחליף! צור עם: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- מסד נתונים (עצמאי לחלוטין, לא משותף עם שום מערכת אחרת) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=inventory_user
DB_PASSWORD=
DB_NAME=resto_inventory
DB_CONNECTION_LIMIT=10

# ---- הגדרות עסקיות ----
# אחוז סטייה מול הספירה הקודמת שמעליו הפריט מסומן כחריגה בסיכום
VARIANCE_ALERT_PERCENT=25
# גודל מקסימלי לקובץ אקסל בייבוא (בבתים)
MAX_UPLOAD_BYTES=10485760
