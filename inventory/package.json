{
  "name": "restaurant-inventory",
  "version": "1.0.0",
  "private": true,
  "description": "מערכת ספירת מלאי למסעדה - שרת Express + MariaDB",
  "main": "server/src/index.js",
  "scripts": {
    "start": "node server/src/index.js",
    "dev": "node --watch server/src/index.js",
    "migrate": "node server/scripts/migrate.js",
    "seed": "node server/scripts/seed.js",
    "test": "node --test server/tests/*.test.js",
    "build:client": "npm --prefix client install && npm --prefix client run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "mysql2": "^3.11.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  }
}
